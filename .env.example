# Environment example for RaportFinansowy24

# Core
APP_URL=http://localhost:3000
NODE_ENV=development
PORT=3000

# AI / Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# News API (used by /api/news)
NEWS_API_KEY=your_newsapi_key_here

# Postback secret (recommended header x-postback-secret)
POSTBACK_SECRET=change_this_to_a_random_string

# Supabase (preferred names for server-side config)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your_service_role_or_api_key

# Legacy client keys (if you need to expose a public anon key - use carefully)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# CORS
# Comma-separated list of allowed origins in production. If empty, all origins are allowed (dev mode).
CORS_ALLOWED_ORIGINS=

# Redirect host whitelist (comma-separated). If set, /api/go will only redirect to these hosts.
ALLOWED_REDIRECT_HOSTS=
